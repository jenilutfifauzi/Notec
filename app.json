{
  "expo": {
    "name": "notec",
    "slug": "notec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notec",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "android": {
      "package": "com.notec.app",
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Izinkan $(PRODUCT_NAME) menggunakan mikrofon untuk mengisi transaksi dengan suara.",
          "speechRecognitionPermission": "Izinkan $(PRODUCT_NAME) mengenali ucapan untuk mengisi transaksi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
